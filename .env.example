LLM_API_KEY=
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Local Postgres (compose.yaml). Dev-only defaults.
POSTGRES_USER=branchiv
POSTGRES_PASSWORD=branchiv
POSTGRES_DB=branchiv
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://branchiv:branchiv@127.0.0.1:5433/branchiv

GENERATION_MODEL=claude-opus-5-5
CHECK_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5
GENERATION_EFFORT=medium
REFUSAL_ESCALATION_THRESHOLD=3
REFUSAL_WINDOW_TURNS=10

# Databricks embeddings (GTE Large En v1.5, 1024 dims).
EMBEDDING_ENDPOINT=databricks-gte-large-en
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
